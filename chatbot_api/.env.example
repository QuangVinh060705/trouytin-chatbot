GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Cách buộc LLM trả JSON đúng schema BotResponse.
# BẮT BUỘC là json_schema với openai/gpt-oss-20b: đo thực tế trên 5 ca trích
# xuất, function_calling (mặc định của langchain) fail 5/5 — model trả markdown
# ```json thay vì gọi tool, đặt tên tool thành "functions.BotResponse", và emit
# null cho trường mảng. json_schema pass 5/5. json_mode fail 5/5, không dùng.
GROQ_STRUCTURED_OUTPUT_METHOD=json_schema

Database__Provider=Postgres
Database__Schema=proptech
ConnectionStrings__DefaultConnection="Host=YOUR_SUPABASE_HOST;Port=5432;Database=postgres;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"

# Backend TroUyTin (Spring Boot). Dùng cho GET /api/listings ở bước đối chiếu
# quyền hiển thị của phòng.
TROUYTIN_API_BASE_URL=http://localhost:8090
TROUYTIN_API_TIMEOUT_SECONDS=10

# Origin được phép gọi API này từ browser. KHÔNG dùng "*" ở môi trường thật.
CHATBOT_CORS_ORIGINS=https://tro-uy-tin.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# BẮT BUỘC phải khai báo, không còn giá trị mặc định: router
# /api/internal/admin/chatbot/* cho phép ĐỌC và XÓA toàn bộ lịch sử hội thoại.
# Phải trùng với trouytin.integration.internal-api-key của TroUyTin backend.
Chatbot__InternalApiKey=dev-internal-key
